rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Memeriksa apakah user telah login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Memeriksa apakah user adalah pemilik dokumen profil
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Koleksi users: Pengguna hanya dapat mengakses profil miliknya sendiri
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Koleksi workspaces
    match /workspaces/{workspaceId} {
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      // Helper function: Memastikan user adalah pemilik workspace induk
      function isWorkspaceOwner() {
        return isAuthenticated() && 
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.user_id == request.auth.uid;
      }

      // Sub-koleksi flow_entries (DevLog alur logika mikro)
      match /flow_entries/{entryId} {
        allow read, write: if isWorkspaceOwner();
      }

      // Sub-koleksi code_annotations (Catatan baris kode read-only)
      match /code_annotations/{annotationId} {
        allow read, write: if isWorkspaceOwner();
      }

      // Sub-koleksi project_todos (Antrean tugas teknis)
      match /project_todos/{todoId} {
        allow read, write: if isWorkspaceOwner();
      }
    }
  }
}
